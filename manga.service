[Unit]
Description=Manga reader (Tailscale only, via tailscale serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/koushik/jason
Environment=MANGA_DIR=/home/koushik/Downloads/Kingdom
Environment=CACHE_VOLUMES=3
ExecStart=/home/koushik/jason/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8770
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
